/-! Formal model of the v0.10 dry run: the per-flow mailbox recurrence.

GENERATED by tools/gen_lean.py from `amateur.dryrun.flow_ops`; do not
hand-edit. State is fully pointwise: each flow's mailbox depth evolves
through its own op word; nothing else can reach it. Over the tick-indexed
accumulators from an all-zero start:

- `boxes_bounded`: every mailbox depth is <= 1 at every tick;
- `boxes_master`: from tick 1 onward the depths are exactly 1 on the
  delayed cycles (#10 Resolved Trajectory, #17 Collapse Mandate) and 0
  everywhere else;
- `misses_master`: misses occur only on the cycles' warm-up (one each at
  tick 1) and freeze thereafter;
- `sunk_master`: exactly the sink flows (#2, #4, #5) drain to the
  boundary, at rate one per tick.
-/

inductive Op where
  | emit | consume | sink
  deriving DecidableEq

/-- One mailbox operation, component-wise so projections survive
symbolic conditions. `sink` moves depth into the sink accumulator. -/
def applyOp (box miss sunk : Nat) : Op -> Nat × Nat × Nat
  | .emit => (box + 1, miss, sunk)
  | .consume =>
      ((if box = 0 then box else box - 1),
       (if box = 0 then miss + 1 else miss),
       sunk)
  | .sink => (0, miss, sunk + box)

/-- Per-flow op word; the arms are generated from `flow_ops()`. -/
def opsOf : Nat -> List Op

  | 1 => [Op.emit, Op.consume]
  | 2 => [Op.emit, Op.sink]
  | 3 => [Op.emit, Op.consume]
  | 4 => [Op.emit, Op.sink]
  | 5 => [Op.emit, Op.sink]
  | 6 => [Op.emit, Op.consume]
  | 7 => [Op.emit, Op.consume]
  | 8 => [Op.emit, Op.consume]
  | 9 => [Op.emit, Op.consume]
  | 10 => [Op.consume, Op.emit]
  | 11 => [Op.emit, Op.consume]
  | 12 => [Op.emit, Op.consume]
  | 13 => [Op.emit, Op.consume]
  | 14 => [Op.emit, Op.consume]
  | 15 => [Op.emit, Op.consume]
  | 16 => [Op.emit, Op.consume]
  | 17 => [Op.consume, Op.emit]
  | 18 => [Op.emit, Op.consume]
  | 19 => [Op.emit, Op.consume]
  | 20 => [Op.emit, Op.consume]
  | 21 => [Op.emit, Op.consume]
  | 22 => [Op.emit, Op.consume]
  | 23 => [Op.emit, Op.consume]
  | 24 => [Op.emit, Op.consume]
  | 25 => [Op.emit, Op.consume]
  | 26 => [Op.emit, Op.consume]
  | _ => []

/-- Per-op weights: exactly one emit / consume in the corresponding op. -/
def isE : Op → Nat
  | .emit => 1
  | _ => 0

def isC : Op → Nat
  | .consume => 1
  | _ => 0

/-- Number of emit ops in a word. -/
def emitCount : List Op → Nat
  | [] => 0
  | op :: rest => isE op + emitCount rest

/-- Number of consume ops in a word (absorbs compile to consume). -/
def consumeCount : List Op → Nat
  | [] => 0
  | op :: rest => isC op + consumeCount rest

/-- One flow's mailbox through a word of ops. -/
def flowFold : List Op → Nat × Nat × Nat → Nat × Nat × Nat
  | [], acc => acc
  | op :: rest, acc => flowFold rest (applyOp acc.1 acc.2.1 acc.2.2 op)

/-- One tick of one flow's mailbox from depth `x`:
returns (box', misses, sunk). -/
def tickFlow (i x : Nat) : Nat × Nat × Nat :=
  flowFold (opsOf i) (x, 0, 0)

/-- Depth accumulator, tick-indexed, from an all-zero start. -/
def bIter : Nat -> Nat -> Nat
  | 0, _ => 0
  | t + 1, i => (tickFlow i (bIter t i)).1

/-- Miss accumulator, tick-indexed, from an all-zero start. -/
def mIter : Nat -> Nat -> Nat
  | 0, _ => 0
  | t + 1, i => mIter t i + (tickFlow i (bIter t i)).2.1

/-- Sunk accumulator, tick-indexed, from an all-zero start. -/
def sIter : Nat -> Nat -> Nat
  | 0, _ => 0
  | t + 1, i => sIter t i + (tickFlow i (bIter t i)).2.2

/-- Master depth profile: the delayed cycles hover at one, everything
else rests at zero. -/
def fbox (i : Nat) : Nat := if i = 10 ∨ i = 17 then 1 else 0

/-- Per-tick sink profile: exactly the sink flows drain one event. -/
def fsinkone (i : Nat) : Nat := if i = 2 ∨ i = 4 ∨ i = 5 then 1 else 0

theorem fbox_zero {i : Nat} (h10 : i ≠ 10) (h17 : i ≠ 17) : fbox i = 0 := by
  rw [fbox, if_neg (by simp [h10, h17])]

theorem fbox_le : ∀ i : Nat, fbox i ≤ 1 := by
  intro i
  simp only [fbox]
  split <;> omega

theorem cycle_10_zero : (tickFlow 10 0).1 = 1 ∧
    (tickFlow 10 0).2.1 = 1 ∧ (tickFlow 10 0).2.2 = 0 := by
  exact ⟨rfl, rfl, rfl⟩
theorem cycle_10_one : (tickFlow 10 1).1 = 1 ∧
    (tickFlow 10 1).2.1 = 0 ∧ (tickFlow 10 1).2.2 = 0 := by
  exact ⟨rfl, rfl, rfl⟩
theorem cycle_17_zero : (tickFlow 17 0).1 = 1 ∧
    (tickFlow 17 0).2.1 = 1 ∧ (tickFlow 17 0).2.2 = 0 := by
  exact ⟨rfl, rfl, rfl⟩
theorem cycle_17_one : (tickFlow 17 1).1 = 1 ∧
    (tickFlow 17 1).2.1 = 0 ∧ (tickFlow 17 1).2.2 = 0 := by
  exact ⟨rfl, rfl, rfl⟩
/-- One warm tick from zero for every non-cycle flow: the depth
rests at zero, nothing is missed, and only sink flows drain. -/
theorem warm_noncycle : ∀ i : Nat, i ≠ 10 → i ≠ 17 →
    (tickFlow i 0).1 = 0 ∧ (tickFlow i 0).2.1 = 0 ∧
    (tickFlow i 0).2.2 = fsinkone i := by
  intro i
  match i with
  | 0 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 1 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 2 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 3 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 4 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 5 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 6 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 7 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 8 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 9 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 10 => intro h10 _; exact absurd rfl h10
  | 11 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 12 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 13 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 14 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 15 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 16 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 17 => intro _ h17; exact absurd rfl h17
  | 18 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 19 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 20 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 21 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 22 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 23 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 24 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 25 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | 26 => intro _ _; exact ⟨rfl, rfl, rfl⟩
  | j + 27 =>
      intro _ _
      have h : ¬ (j + 27 = 2 ∨ j + 27 = 4 ∨ j + 27 = 5) := by omega
      simp only [fsinkone, if_neg h]
      exact ⟨rfl, rfl, rfl⟩

theorem warm_box : ∀ i : Nat, (tickFlow i 0).1 = fbox i := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 0).1 = 1; exact (cycle_10_zero).1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 0).1 = 1; exact (cycle_17_zero).1
    · rw [fbox_zero h10 h17]
      exact (warm_noncycle i h10 h17).1

theorem warm_miss : ∀ i : Nat, (tickFlow i 0).2.1 = fbox i := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 0).2.1 = 1; exact (cycle_10_zero).2.1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 0).2.1 = 1; exact (cycle_17_zero).2.1
    · rw [fbox_zero h10 h17]
      exact (warm_noncycle i h10 h17).2.1

theorem warm_sunk : ∀ i : Nat, (tickFlow i 0).2.2 = fsinkone i := by
  intro i
  by_cases h10 : i = 10
  · subst h10
    show (tickFlow 10 0).2.2 = 0
    exact (cycle_10_zero).2.2
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 0).2.2 = 0; exact (cycle_17_zero).2.2
    · exact (warm_noncycle i h10 h17).2.2


theorem step_box : ∀ i : Nat, (tickFlow i (fbox i)).1 = fbox i := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 1).1 = 1; exact (cycle_10_one).1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 1).1 = 1; exact (cycle_17_one).1
    · have hf := fbox_zero h10 h17
      rw [hf, warm_box i]
      exact hf

theorem step_miss : ∀ i : Nat, (tickFlow i (fbox i)).2.1 = 0 := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 1).2.1 = 0; exact (cycle_10_one).2.1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 1).2.1 = 0; exact (cycle_17_one).2.1
    · rw [fbox_zero h10 h17, warm_miss i, fbox_zero h10 h17]

theorem step_sunk : ∀ i : Nat, (tickFlow i (fbox i)).2.2 = fsinkone i := by
  intro i
  by_cases h10 : i = 10
  · subst h10
    have h : fsinkone 10 = 0 := by simp [fsinkone]
    rw [show fbox 10 = 1 from rfl, h]
    exact (cycle_10_one).2.2
  · by_cases h17 : i = 17
    · subst h17
      have h : fsinkone 17 = 0 := by simp [fsinkone]
      rw [show fbox 17 = 1 from rfl, h]
      exact (cycle_17_one).2.2
    · rw [fbox_zero h10 h17, warm_sunk i]


theorem boxes_master : ∀ t i : Nat, 1 ≤ t → bIter t i = fbox i := by
  intro t
  induction t with
  | zero => intro i h; omega
  | succ k ih =>
      intro i h1
      by_cases hk : k = 0
      · subst hk
        show (tickFlow i (bIter 0 i)).1 = fbox i
        rw [show bIter 0 i = 0 from rfl]
        exact warm_box i
      · have hk1 : 1 ≤ k := by omega
        show (tickFlow i (bIter k i)).1 = fbox i
        rw [ih i hk1]
        exact step_box i

theorem misses_master : ∀ t i : Nat, 1 ≤ t → mIter t i = fbox i := by
  intro t
  induction t with
  | zero => intro i h; omega
  | succ k ih =>
      intro i h1
      by_cases hk : k = 0
      · subst hk
        show mIter 0 i + (tickFlow i (bIter 0 i)).2.1 = fbox i
        rw [show mIter 0 i = 0 from rfl, show bIter 0 i = 0 from rfl,
            Nat.zero_add, warm_miss i]
      · have hk1 : 1 ≤ k := by omega
        show mIter k i + (tickFlow i (bIter k i)).2.1 = fbox i
        rw [boxes_master k i hk1, step_miss i, ih i hk1, Nat.add_zero]

theorem sunk_master : ∀ t i : Nat, sIter t i = t * fsinkone i := by
  intro t
  induction t with
  | zero => intro i; exact (Nat.zero_mul (fsinkone i)).symm
  | succ k ih =>
      intro i
      show sIter k i + (tickFlow i (bIter k i)).2.2 = (k + 1) * fsinkone i
      by_cases hk : k = 0
      · subst hk
        rw [show sIter 0 i = 0 from rfl, show bIter 0 i = 0 from rfl,
            warm_sunk i, Nat.zero_add, Nat.one_mul]
      · have hk1 : 1 ≤ k := by omega
        rw [boxes_master k i hk1, step_sunk i, ih i, Nat.succ_mul]

theorem boxes_bounded : ∀ t i : Nat, bIter t i ≤ 1 := by
  intro t i
  by_cases ht : t = 0
  · subst ht; simp [bIter]
  · have h := boxes_master t i (by omega)
    rw [h]
    exact fbox_le i

/-- Single-op balance: box + sunk plus consume-weight is conserved up
through emits and misses. -/
theorem applyOp_step (b m s : Nat) (o : Op) :
    (applyOp b m s o).1 + (applyOp b m s o).2.2 + isC o + m
      = b + s + isE o + (applyOp b m s o).2.1 := by
  cases o <;> by_cases h : b = 0 <;> simp [applyOp, isC, isE, h] <;> omega

/-- The fold-wide balance invariant with anchored counters: from any
mailbox state, result box + sunk + consumed attempts + incoming misses
is fixed by the word's emit/consume weights. -/
theorem fold_balance : ∀ (l : List Op) (b m s c _e : Nat),
    m ≤ (flowFold l (b, m, s)).2.1 ∧
    (flowFold l (b, m, s)).1 + (flowFold l (b, m, s)).2.2
      + (c + consumeCount l) + m
      = (b + s + c) + emitCount l + (flowFold l (b, m, s)).2.1 := by
  intro l
  induction l with
  | nil =>
      intro b m s c _e
      refine ⟨Nat.le_refl _, ?_⟩
      simp only [flowFold, consumeCount, emitCount]
      omega
  | cons op rest ih =>
      intro b m s c _e
      have ihb := ih (applyOp b m s op).1 (applyOp b m s op).2.1
        (applyOp b m s op).2.2 c _e
      have hop := applyOp_step b m s op
      have hmono : m ≤ (applyOp b m s op).2.1 := by
        cases op <;> by_cases h : b = 0 <;> simp [applyOp, isC, isE, h] <;> omega
      have hfish : flowFold rest (applyOp b m s op)
          = flowFold rest ((applyOp b m s op).1,
              (applyOp b m s op).2.1, (applyOp b m s op).2.2) := rfl
      rw [hfish] at ihb
      constructor
      · show m ≤ (flowFold rest (applyOp b m s op)).2.1
        rw [hfish]
        omega
      · show (flowFold rest (applyOp b m s op)).1
            + (flowFold rest (applyOp b m s op)).2.2
            + (c + (isC op + consumeCount rest)) + m
          = (b + s + c) + (isE op + emitCount rest)
            + (flowFold rest (applyOp b m s op)).2.1
        rw [hfish]
        omega

theorem flow_balance : ∀ (i x : Nat),
    (tickFlow i x).1 + (tickFlow i x).2.2 + consumeCount (opsOf i)
      = x + emitCount (opsOf i) + (tickFlow i x).2.1 := by
  intro i x
  simpa using (fold_balance (opsOf i) x 0 0 0 0).2

/-- INV-LIVENESS: every ledger flow emits exactly once per tick. -/
theorem emit_liveness : ∀ i : Nat, 1 ≤ i → i < 27 → emitCount (opsOf i) = 1 := by
  intro i h1 hi
  match i with
  | 0 => omega
  | 1 => rfl
  | 2 => rfl
  | 3 => rfl
  | 4 => rfl
  | 5 => rfl
  | 6 => rfl
  | 7 => rfl
  | 8 => rfl
  | 9 => rfl
  | 10 => rfl
  | 11 => rfl
  | 12 => rfl
  | 13 => rfl
  | 14 => rfl
  | 15 => rfl
  | 16 => rfl
  | 17 => rfl
  | 18 => rfl
  | 19 => rfl
  | 20 => rfl
  | 21 => rfl
  | 22 => rfl
  | 23 => rfl
  | 24 => rfl
  | 25 => rfl
  | 26 => rfl
  | j + 27 => omega

/-- Every flow either consumes or drains as a sink, exactly once. -/
theorem consume_sink_split : ∀ i : Nat, 1 ≤ i → i < 27 →
    consumeCount (opsOf i) + fsinkone i = 1 := by
  intro i h1 hi
  match i with
  | 0 => omega
  | 1 => rfl
  | 2 => rfl
  | 3 => rfl
  | 4 => rfl
  | 5 => rfl
  | 6 => rfl
  | 7 => rfl
  | 8 => rfl
  | 9 => rfl
  | 10 => rfl
  | 11 => rfl
  | 12 => rfl
  | 13 => rfl
  | 14 => rfl
  | 15 => rfl
  | 16 => rfl
  | 17 => rfl
  | 18 => rfl
  | 19 => rfl
  | 20 => rfl
  | 21 => rfl
  | 22 => rfl
  | 23 => rfl
  | 24 => rfl
  | 25 => rfl
  | 26 => rfl
  | j + 27 => omega

/-- INV-CONSERVE, per flow at the master profile: box' + sunk' +
attempted consumes = fbox i + 1. Combined with `boxes_master` over the
fid set this is the executor's conservation identity. -/
theorem balance_at_master : ∀ i : Nat, 1 ≤ i → i < 27 →
    (tickFlow i (fbox i)).1 + (tickFlow i (fbox i)).2.2
      + consumeCount (opsOf i)
      = fbox i + 1 := by
  intro i h1 hi
  have hb := flow_balance i (fbox i)
  have he := emit_liveness i h1 hi
  have hc := consume_sink_split i h1 hi
  have h1 := step_box i
  have h2 := step_miss i
  have h3 := step_sunk i
  omega


/-! ## Typed geometry payloads

Payload schema (user-adjudicated):

- D2 (Multi-Layer Mat) writes [23, 24] carry epoch-stamped
  overlays; the #25 stale read pairs with each #24 ratchet write in the
  same stage;
- D4 (Base Core) write [22] carries bias primitives only.
  The whitelist closes the channel by construction: a trajectory,
  state-delta, or context payload kind is not forbidden on D4 -- it is
  unrepresentable;
- the D2 mat lifecycle recycles one overlay per tick and evicts past
  capacity 4, so no resident epoch falls more than one tick
  behind the present (INV-NO-OSSIFY). -/

inductive PayloadKind where
  | traj | delta | ctx | overlay | bias
  deriving DecidableEq

def d4Allowed : List PayloadKind := [PayloadKind.bias]
def d2Allowed : List PayloadKind := [PayloadKind.overlay]
def forbiddenOfGeometry : List PayloadKind :=
  [PayloadKind.traj, PayloadKind.delta, PayloadKind.ctx]

def d4WriteFids : List Nat := [22]
def d2WriteFids : List Nat := [23, 24]

/-- INV-EMPTINESS as a type-level fact: the forbidden kinds are excluded
from every geometry write channel. -/
theorem geometry_write_channel_purity :
    ∀ k ∈ forbiddenOfGeometry, k ∉ d4Allowed ∧ k ∉ d2Allowed := by
  intro k hk
  cases k <;> simp_all [d4Allowed, d2Allowed, forbiddenOfGeometry]

/-- Both geometry write channels are ratchet-owned flows, absorbed
(compiled to consume) on the spine. -/
theorem geometry_writes_anchored :
    d4WriteFids = [22] ∧ d2WriteFids = [23, 24] ∧
      (opsOf 22).getLast? = some Op.consume ∧
      (opsOf 23).getLast? = some Op.consume :=
  ⟨rfl, rfl, by decide, by decide⟩

/-- One mat tick: birth appended, head recycled at the current epoch,
then an eviction iff the board exceeds capacity 4. -/
def revTop (l : List Nat) (t : Nat) : List Nat :=
  match l with
  | [] => [t]
  | _ :: rest => rest ++ [t]

def matTick (l : List Nat) (t : Nat) : List Nat :=
  let rev := revTop (l ++ [t]) t
  if rev.length > 4 then rev.drop 1 else rev

def matRun : Nat → List Nat
  | 0 => [0]
  | t + 1 => matTick (matRun t) (t + 1)

theorem rep2 (v : Nat) : List.replicate 2 v = v :: v :: [] := rfl
theorem mat_close_1 : matRun 1 = [1, 1] := rfl
theorem mat_close_2 : matRun 2 = [1, 2, 2] := rfl

/-- The operational run coincides with the two-band closed shape:
from tick 3 the resident epochs are exactly {t-1, t-1, t, t}. -/
theorem matTick_length : ∀ (s : List Nat) (t : Nat), s.length ≤ 4 →
    (matTick s t).length ≤ 4 := by
  intro s t h
  cases s with
  | nil => simp [matTick, revTop]
  | cons a r =>
      have hrev : revTop ((a :: r) ++ [t]) t = (r ++ [t]) ++ [t] := rfl
      simp only [matTick, hrev]
      have hlen : ((r ++ [t]) ++ [t]).length = r.length + 2 := by simp
      rw [hlen]
      have hcons : (a :: r).length = r.length + 1 := rfl
      by_cases hr : r.length + 2 > 4
      · rw [if_pos hr, List.length_drop, hlen]
        omega
      · rw [if_neg hr, hlen]
        omega

/-- Policy-relative form: the schedule is an explicit hypothesis, not a
silent assumption. These theorems quantify over EVERY resident-epoch
stream that obeys the mat update law (seed [0], one matTick per tick) —
they say nothing about arrival streams outside that law. -/
theorem mat_operational_policy : ∀ (run : Nat → List Nat),
    run 0 = [0] → (∀ k, run (k + 1) = matTick (run k) (k + 1)) →
    ∀ t, run (t + 3)
      = List.replicate 2 (t + 2) ++ List.replicate 2 (t + 3) := by
  intro run h0 hU t
  induction t with
  | zero =>
      rw [hU 2, hU 1, hU 0, h0]
      rfl
  | succ k ih =>
      have hlhs : run (k + 4) = matTick (run (k + 3)) (k + 4) := hU (k + 3)
      rw [hlhs, ih, rep2]
      simp [matTick, revTop]

/-- INV-NO-OSSIFY, policy-relative: no resident epoch falls more than
one tick behind — for every stream obeying the update law. -/
theorem mat_fresh_policy : ∀ (run : Nat → List Nat),
    run 0 = [0] → (∀ k, run (k + 1) = matTick (run k) (k + 1)) →
    ∀ t, 1 ≤ t → ∀ e ∈ run t, e = t ∨ e + 1 = t := by
  intro run h0 hU t
  match t with
  | 0 => intro h; omega
  | 1 =>
      intro _ e he
      have h1 : run 1 = [1, 1] := by rw [hU 0, h0]; rfl
      rw [h1] at he
      simp at he
      omega
  | 2 =>
      intro _ e he
      have h2 : run 2 = [1, 2, 2] := by rw [hU 1, hU 0, h0]; rfl
      rw [h2] at he
      simp at he
      omega
  | t + 3 =>
      intro _ e he
      rw [mat_operational_policy run h0 hU t, rep2] at he
      simp at he
      omega

/-- Capacity bound, policy-relative: for every stream obeying the
update law, the mat never exceeds its capacity. -/
theorem mat_bounded_policy : ∀ (run : Nat → List Nat),
    run 0 = [0] → (∀ k, run (k + 1) = matTick (run k) (k + 1)) →
    ∀ t, (run t).length ≤ 4 := by
  intro run h0 hU t
  induction t with
  | zero => rw [h0]; decide
  | succ k ih =>
      rw [hU k]
      exact matTick_length (run k) (k + 1) ih

/-- The dry-run minter satisfies the law, so the policy theorems
specialize to it. -/
theorem mat_operational : ∀ t : Nat, matRun (t + 3)
    = List.replicate 2 (t + 2) ++ List.replicate 2 (t + 3) :=
  mat_operational_policy matRun rfl (fun _ => rfl)

/-- INV-NO-OSSIFY for the dry-run minter. -/
theorem mat_fresh : ∀ t : Nat, 1 ≤ t →
    ∀ e ∈ matRun t, e = t ∨ e + 1 = t :=
  mat_fresh_policy matRun rfl (fun _ => rfl)

/-- Capacity bound for the dry-run minter. -/
theorem mat_bounded : ∀ t : Nat, (matRun t).length ≤ 4 :=
  mat_bounded_policy matRun rfl (fun _ => rfl)

