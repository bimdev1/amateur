/-! Formal model of the v0.10 dry run: the per-flow mailbox recurrence
under reject-with-charge admission (user-adjudicated channel semantics).

GENERATED by tools/gen_lean.py from `amateur.dryrun.flow_ops`; do not
hand-edit. State is fully pointwise: each flow's channel evolves through
its own op word; nothing else can reach it. `applyOp` is one admission
event: emit accepts onto an empty box and refuses onto a full one (the
refused copy is discarded at the channel; only a scalar excess charge
remains); consume drains a non-empty box and charges a deficit miss on
an empty one; deficit and excess counters stay separate, never summed.
Over the tick-indexed accumulators from an all-zero start:

- `refused_master`: the canonical schedule refuses nothing, at any tick
  (nothing ever fires on #10/#17 either); the mechanism is pinned by
  `cycle_warm_no_refusal` and `cycle_burst_refuses_extras`, whose
  ordering assumption (`opsOf i = [Op.consume, Op.emit]`) is an explicit
  theorem hypothesis, per the cadence-audit discipline;
- `boxes_bounded`: every mailbox depth is <= 1 at every tick;
- `fold_box_bounded` / `step_contraction`: the intra-tick strengthening
  (adjudicated INV-BOUNDS): depth <= 1 after every event boundary of any
  compliant word;
- `boxes_master`: from tick 1 onward the depths are exactly 1 on the
  delayed cycles (#10 Resolved Trajectory, #17 Collapse Mandate) and 0
  everywhere else;
- `misses_master`: misses occur only on the cycles' warm-up (one each at
  tick 1) and freeze thereafter;
- `sunk_master`: exactly the sink flows (#2, #4, #5) drain to the
  boundary, at rate one per tick;
- `fold_attempt` / `fold_event`: the two word-generic conservation
  identities (adjudicated): attempted = accepted + refused, and
  accepted = consumed + delta-sunk + depth, with `attempts_at_master` /
  `balance_at_master` at the master profile;
- `d2_write_split` / `candidate_recorded_from_birth`: the D2 write
  channels are pinned per flow (#18 candidate birth, #24 overlay
  ratchet), disjoint and exactly the D2 writes;
- `nursery_*`: the candidate index has its own lifecycle, separate from
  the overlay-index policy (`mat_*_policy`), which is unchanged and is
  not restated.
-/

inductive Op where
  | emit | consume | sink
  deriving DecidableEq

/-- Per-flow op word; the arms are generated from `flow_ops()`. -/
def opsOf : Nat -> List Op

  | 1 => [Op.emit, Op.consume]
  | 2 => [Op.emit, Op.sink]
  | 3 => [Op.emit, Op.consume]
  | 4 => [Op.emit, Op.sink]
  | 5 => [Op.emit, Op.sink]
  | 6 => [Op.emit, Op.consume]
  | 7 => [Op.emit, Op.consume]
  | 8 => [Op.emit, Op.consume]
  | 9 => [Op.emit, Op.consume]
  | 10 => [Op.consume, Op.emit]
  | 11 => [Op.emit, Op.consume]
  | 12 => [Op.emit, Op.consume]
  | 13 => [Op.emit, Op.consume]
  | 14 => [Op.emit, Op.consume]
  | 15 => [Op.emit, Op.consume]
  | 16 => [Op.emit, Op.consume]
  | 17 => [Op.consume, Op.emit]
  | 18 => [Op.emit, Op.consume]
  | 19 => [Op.emit, Op.consume]
  | 20 => [Op.emit, Op.consume]
  | 21 => [Op.emit, Op.consume]
  | 22 => [Op.emit, Op.consume]
  | 23 => [Op.emit, Op.consume]
  | 24 => [Op.emit, Op.consume]
  | 25 => [Op.emit, Op.consume]
  | 26 => [Op.emit, Op.consume]
  | 27 => [Op.emit, Op.consume]
  | _ => []

/-- Channel state: mailbox depth plus the scalar charge and accounting
counters. Refused events never materialize as state; refusal is a
charge only, O(1) per channel exactly like a sink. -/
structure St where
  box : Nat
  miss : Nat
  refused : Nat
  sunk : Nat
  used : Nat
  consumed : Nat

/-- Fresh channel with mailbox depth `b`; every counter at zero. -/
def mkSt (b : Nat) : St := ⟨b, 0, 0, 0, 0, 0⟩

theorem mkSt_fields (x : Nat) :
    (mkSt x).box = x ∧ (mkSt x).miss = 0 ∧ (mkSt x).refused = 0
      ∧ (mkSt x).sunk = 0 ∧ (mkSt x).used = 0 ∧ (mkSt x).consumed = 0 :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- One admission event, reject-with-charge (adjudicated): emit accepts
onto an empty box and refuses onto a full one; consume drains a
non-empty box and misses on an empty one; deficit (miss) and excess
(refused) are distinct counters that are never added. -/
def applyOp (st : St) : Op -> St
  | .emit =>
      ⟨if st.box = 0 then 1 else st.box, st.miss,
        st.refused + (if st.box = 0 then 0 else 1), st.sunk,
        st.used + (if st.box = 0 then 1 else 0), st.consumed⟩
  | .consume =>
      ⟨if st.box = 0 then st.box else st.box - 1,
        (if st.box = 0 then st.miss + 1 else st.miss), st.refused, st.sunk,
        st.used, if st.box = 0 then st.consumed else st.consumed + 1⟩
  | .sink => ⟨0, st.miss, st.refused, st.sunk + st.box, st.used, st.consumed⟩

/-- Per-op weights: exactly one emit / consume in the corresponding op. -/
def isE : Op → Nat
  | .emit => 1
  | _ => 0

def isC : Op → Nat
  | .consume => 1
  | _ => 0

/-- Number of emit ops in a word. -/
def emitCount : List Op → Nat
  | [] => 0
  | op :: rest => isE op + emitCount rest

/-- Number of consume ops in a word (absorbs compile to consume). -/
def consumeCount : List Op → Nat
  | [] => 0
  | op :: rest => isC op + consumeCount rest

/-- One flow's channel through a word of ops. -/
def flowFold : List Op → St → St
  | [], st => st
  | op :: rest, st => flowFold rest (applyOp st op)

/-- One tick of one flow's channel from depth `x`. -/
def tickFlow (i x : Nat) : St := flowFold (opsOf i) (mkSt x)

/-- Depth accumulator, tick-indexed, from an all-zero start. -/
def bIter : Nat -> Nat -> Nat
  | 0, _ => 0
  | t + 1, i => (tickFlow i (bIter t i)).box

/-- Miss (deficit charge) accumulator, tick-indexed, from zero. -/
def mIter : Nat -> Nat -> Nat
  | 0, _ => 0
  | t + 1, i => mIter t i + (tickFlow i (bIter t i)).miss

/-- Refusal (excess charge) accumulator, tick-indexed, from zero. -/
def rIter : Nat -> Nat -> Nat
  | 0, _ => 0
  | t + 1, i => rIter t i + (tickFlow i (bIter t i)).refused

/-- Sunk accumulator, tick-indexed, from an all-zero start. -/
def sIter : Nat -> Nat -> Nat
  | 0, _ => 0
  | t + 1, i => sIter t i + (tickFlow i (bIter t i)).sunk

/-- Master depth profile: the delayed cycles hover at one, everything
else rests at zero. -/
def fbox (i : Nat) : Nat := if i = 10 ∨ i = 17 then 1 else 0

/-- Per-tick sink profile: exactly the sink flows drain one event. -/
def fsinkone (i : Nat) : Nat := if i = 2 ∨ i = 4 ∨ i = 5 then 1 else 0

theorem fbox_zero {i : Nat} (h10 : i ≠ 10) (h17 : i ≠ 17) : fbox i = 0 := by
  rw [fbox, if_neg (by simp [h10, h17])]

theorem fbox_le : ∀ i : Nat, fbox i ≤ 1 := by
  intro i
  simp only [fbox]
  split <;> omega

theorem cycle_10_zero : (tickFlow 10 0).box = 1 ∧
    (tickFlow 10 0).miss = 1 ∧ (tickFlow 10 0).refused = 0 ∧
    (tickFlow 10 0).sunk = 0 := by
  exact ⟨rfl, rfl, rfl, rfl⟩
theorem cycle_10_one : (tickFlow 10 1).box = 1 ∧
    (tickFlow 10 1).miss = 0 ∧ (tickFlow 10 1).refused = 0 ∧
    (tickFlow 10 1).sunk = 0 := by
  exact ⟨rfl, rfl, rfl, rfl⟩
theorem cycle_17_zero : (tickFlow 17 0).box = 1 ∧
    (tickFlow 17 0).miss = 1 ∧ (tickFlow 17 0).refused = 0 ∧
    (tickFlow 17 0).sunk = 0 := by
  exact ⟨rfl, rfl, rfl, rfl⟩
theorem cycle_17_one : (tickFlow 17 1).box = 1 ∧
    (tickFlow 17 1).miss = 0 ∧ (tickFlow 17 1).refused = 0 ∧
    (tickFlow 17 1).sunk = 0 := by
  exact ⟨rfl, rfl, rfl, rfl⟩
/-- One warm tick from zero for every non-cycle flow: the depth
rests at zero, nothing is missed or refused, and only sink flows
drain. -/
theorem warm_noncycle : ∀ i : Nat, i ≠ 10 → i ≠ 17 →
    (tickFlow i 0).box = 0 ∧ (tickFlow i 0).miss = 0 ∧
    (tickFlow i 0).refused = 0 ∧ (tickFlow i 0).sunk = fsinkone i := by
  intro i
  match i with
  | 0 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 1 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 2 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 3 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 4 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 5 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 6 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 7 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 8 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 9 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 10 => intro h10 _; exact absurd rfl h10
  | 11 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 12 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 13 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 14 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 15 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 16 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 17 => intro _ h17; exact absurd rfl h17
  | 18 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 19 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 20 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 21 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 22 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 23 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 24 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 25 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 26 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | 27 => intro _ _; exact ⟨rfl, rfl, rfl, rfl⟩
  | j + 28 =>
      intro _ _
      have h : ¬ (j + 28 = 2 ∨ j + 28 = 4 ∨ j + 28 = 5) := by omega
      simp only [fsinkone, if_neg h]
      exact ⟨rfl, rfl, rfl, rfl⟩

theorem warm_box : ∀ i : Nat, (tickFlow i 0).box = fbox i := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 0).box = 1; exact (cycle_10_zero).1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 0).box = 1; exact (cycle_17_zero).1
    · rw [fbox_zero h10 h17]
      exact (warm_noncycle i h10 h17).1

theorem warm_miss : ∀ i : Nat, (tickFlow i 0).miss = fbox i := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 0).miss = 1; exact (cycle_10_zero).2.1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 0).miss = 1; exact (cycle_17_zero).2.1
    · rw [fbox_zero h10 h17]
      exact (warm_noncycle i h10 h17).2.1

theorem warm_refused : ∀ i : Nat, (tickFlow i 0).refused = 0 := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 0).refused = 0; exact (cycle_10_zero).2.2.1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 0).refused = 0; exact (cycle_17_zero).2.2.1
    · exact (warm_noncycle i h10 h17).2.2.1

theorem warm_sunk : ∀ i : Nat, (tickFlow i 0).sunk = fsinkone i := by
  intro i
  by_cases h10 : i = 10
  · subst h10
    show (tickFlow 10 0).sunk = 0
    exact (cycle_10_zero).2.2.2
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 0).sunk = 0; exact (cycle_17_zero).2.2.2
    · exact (warm_noncycle i h10 h17).2.2.2


theorem step_box : ∀ i : Nat, (tickFlow i (fbox i)).box = fbox i := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 1).box = 1; exact (cycle_10_one).1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 1).box = 1; exact (cycle_17_one).1
    · have hf := fbox_zero h10 h17
      rw [hf, warm_box i]
      exact hf

theorem step_miss : ∀ i : Nat, (tickFlow i (fbox i)).miss = 0 := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 1).miss = 0; exact (cycle_10_one).2.1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 1).miss = 0; exact (cycle_17_one).2.1
    · rw [fbox_zero h10 h17, warm_miss i, fbox_zero h10 h17]

theorem step_refused : ∀ i : Nat, (tickFlow i (fbox i)).refused = 0 := by
  intro i
  by_cases h10 : i = 10
  · subst h10; show (tickFlow 10 1).refused = 0; exact (cycle_10_one).2.2.1
  · by_cases h17 : i = 17
    · subst h17; show (tickFlow 17 1).refused = 0; exact (cycle_17_one).2.2.1
    · rw [fbox_zero h10 h17]
      exact warm_refused i

theorem step_sunk : ∀ i : Nat, (tickFlow i (fbox i)).sunk = fsinkone i := by
  intro i
  by_cases h10 : i = 10
  · subst h10
    have h : fsinkone 10 = 0 := by simp [fsinkone]
    rw [show fbox 10 = 1 from rfl, h]
    exact (cycle_10_one).2.2.2
  · by_cases h17 : i = 17
    · subst h17
      have h : fsinkone 17 = 0 := by simp [fsinkone]
      rw [show fbox 17 = 1 from rfl, h]
      exact (cycle_17_one).2.2.2
    · rw [fbox_zero h10 h17, warm_sunk i]


theorem boxes_master : ∀ t i : Nat, 1 ≤ t → bIter t i = fbox i := by
  intro t
  induction t with
  | zero => intro i h; omega
  | succ k ih =>
      intro i h1
      by_cases hk : k = 0
      · subst hk
        show (tickFlow i (bIter 0 i)).box = fbox i
        rw [show bIter 0 i = 0 from rfl]
        exact warm_box i
      · have hk1 : 1 ≤ k := by omega
        show (tickFlow i (bIter k i)).box = fbox i
        rw [ih i hk1]
        exact step_box i

theorem misses_master : ∀ t i : Nat, 1 ≤ t → mIter t i = fbox i := by
  intro t
  induction t with
  | zero => intro i h; omega
  | succ k ih =>
      intro i h1
      by_cases hk : k = 0
      · subst hk
        show mIter 0 i + (tickFlow i (bIter 0 i)).miss = fbox i
        rw [show mIter 0 i = 0 from rfl, show bIter 0 i = 0 from rfl,
            Nat.zero_add, warm_miss i]
      · have hk1 : 1 ≤ k := by omega
        show mIter k i + (tickFlow i (bIter k i)).miss = fbox i
        rw [boxes_master k i hk1, step_miss i, ih i hk1, Nat.add_zero]

theorem refused_master : ∀ t i : Nat, 1 ≤ t → rIter t i = 0 := by
  intro t
  induction t with
  | zero => intro i h; omega
  | succ k ih =>
      intro i h1
      by_cases hk : k = 0
      · subst hk
        show rIter 0 i + (tickFlow i (bIter 0 i)).refused = 0
        rw [show rIter 0 i = 0 from rfl, show bIter 0 i = 0 from rfl,
            warm_refused i, Nat.zero_add]
      · have hk1 : 1 ≤ k := by omega
        show rIter k i + (tickFlow i (bIter k i)).refused = 0
        rw [boxes_master k i hk1, step_refused i, ih i hk1, Nat.add_zero]

theorem sunk_master : ∀ t i : Nat, sIter t i = t * fsinkone i := by
  intro t
  induction t with
  | zero => intro i; exact (Nat.zero_mul (fsinkone i)).symm
  | succ k ih =>
      intro i
      show sIter k i + (tickFlow i (bIter k i)).sunk = (k + 1) * fsinkone i
      by_cases hk : k = 0
      · subst hk
        rw [show sIter 0 i = 0 from rfl, show bIter 0 i = 0 from rfl,
            warm_sunk i, Nat.zero_add, Nat.one_mul]
      · have hk1 : 1 ≤ k := by omega
        rw [boxes_master k i hk1, step_sunk i, ih i, Nat.succ_mul]

theorem boxes_bounded : ∀ t i : Nat, bIter t i ≤ 1 := by
  intro t i
  by_cases ht : t = 0
  · subst ht; simp [bIter]
  · have h := boxes_master t i (by omega)
    rw [h]
    exact fbox_le i

/-! ## Word-generic channel lemmas

The adjudicated conservation identities and the intra-tick depth bound,
stated for ANY op word and ANY compliant incoming state; the generated
table is one instance of them. -/

theorem applyOp_attempt (st : St) (o : Op) :
    (applyOp st o).refused + (applyOp st o).used
      = st.refused + st.used + isE o := by
  cases o <;> by_cases hb : st.box = 0 <;> simp [applyOp, isE, hb] <;> omega

theorem fold_attempt : ∀ (l : List Op) (st : St),
    (flowFold l st).refused + (flowFold l st).used
      = st.refused + st.used + emitCount l := by
  intro l
  induction l with
  | nil => intro st; simp [flowFold, emitCount]
  | cons op rest ih =>
      intro st
      have hstep := applyOp_attempt st op
      have hrest := ih (applyOp st op)
      show (flowFold rest (applyOp st op)).refused
            + (flowFold rest (applyOp st op)).used
          = st.refused + st.used + (isE op + emitCount rest)
      omega

theorem applyOp_take (st : St) (o : Op) :
    (applyOp st o).consumed + (applyOp st o).miss
      = st.consumed + st.miss + isC o := by
  cases o <;> by_cases hb : st.box = 0 <;> simp [applyOp, isC, hb] <;> omega

theorem fold_take : ∀ (l : List Op) (st : St),
    (flowFold l st).consumed + (flowFold l st).miss
      = st.consumed + st.miss + consumeCount l := by
  intro l
  induction l with
  | nil => intro st; simp [flowFold, consumeCount]
  | cons op rest ih =>
      intro st
      have hstep := applyOp_take st op
      have hrest := ih (applyOp st op)
      show (flowFold rest (applyOp st op)).consumed
            + (flowFold rest (applyOp st op)).miss
          = st.consumed + st.miss + (isC op + consumeCount rest)
      omega

/-- Per-event identity B: accepted minus consumed minus sunk minus depth
is carried through every event (a used event is then consumed, sunk at
the boundary, or left in the box; a refused copy is never used; a miss
moves nothing). -/
theorem applyOp_event (st : St) (o : Op) :
    (applyOp st o).used + st.consumed + st.sunk + st.box
      = st.used + (applyOp st o).consumed + (applyOp st o).sunk
          + (applyOp st o).box := by
  cases o <;> by_cases hb : st.box = 0 <;> simp [applyOp, hb] <;> omega

theorem fold_event : ∀ (l : List Op) (st : St),
    (flowFold l st).used + st.consumed + st.sunk + st.box
      = st.used + (flowFold l st).consumed + (flowFold l st).sunk
          + (flowFold l st).box := by
  intro l
  induction l with
  | nil => intro st; simp [flowFold]
  | cons op rest ih =>
      intro st
      have hstep := applyOp_event st op
      have hrest := ih (applyOp st op)
      simp only [flowFold] at hrest ⊢
      omega

/-- Word split law: a fold over concatenated words composes. -/
theorem fold_append : ∀ (l1 l2 : List Op) (st : St),
    flowFold (l1 ++ l2) st = flowFold l2 (flowFold l1 st) := by
  intro l1
  induction l1 with
  | nil => intro l2 st; rfl
  | cons op rest ih => intro l2 st; exact ih l2 (applyOp st op)

/-- INV-BOUNDS, intra-tick (adjudicated): after any number of events, a
compliant depth never exceeds one -- an emit onto a full box is refused,
never buffered, so no event sequence can push the depth past one. -/
theorem fold_box_bounded : ∀ (l : List Op) (st : St),
    st.box ≤ 1 → (flowFold l st).box ≤ 1 := by
  intro l
  induction l with
  | nil => intro st hb; exact hb
  | cons op rest ih =>
      intro st hb
      refine ih (applyOp st op) ?_
      cases op <;> by_cases h0 : st.box = 0 <;> simp [applyOp, h0] <;> omega

theorem step_contraction : ∀ (i : Nat) (st : St),
    st.box ≤ 1 → (flowFold (opsOf i) st).box ≤ 1 := by
  intro i st hb
  exact fold_box_bounded (opsOf i) st hb

/-- Multiplicity k onto a full box: every copy refused, the accepted
event stays, nothing is buffered. -/
theorem emit_full_box : ∀ (k : Nat) (st : St), st.box = 1 →
    (flowFold (List.replicate k Op.emit) st).box = 1
      ∧ (flowFold (List.replicate k Op.emit) st).used = st.used
      ∧ (flowFold (List.replicate k Op.emit) st).refused = st.refused + k := by
  intro k
  induction k with
  | zero => intro st hst; exact ⟨hst, rfl, rfl⟩
  | succ k ih =>
      intro st hst
      have hcons : flowFold (List.replicate (k + 1) Op.emit) st
          = flowFold (List.replicate k Op.emit) (applyOp st Op.emit) := rfl
      have hbox : (applyOp st Op.emit).box = 1 := by simp [applyOp, hst]
      have hub : (applyOp st Op.emit).used = st.used := by simp [applyOp, hst]
      have hrb : (applyOp st Op.emit).refused = st.refused + 1 := by
        simp [applyOp, hst]
      have hfull := ih (applyOp st Op.emit) hbox
      rw [hcons]
      refine ⟨hfull.1, ?_, ?_⟩
      · rw [hfull.2.1, hub]
      · rw [hfull.2.2, hrb]
        omega

/-- Multiplicity k + 1 onto an empty box: the first copy accepted, the
remaining k refused. -/
theorem emit_empty_box : ∀ (k : Nat) (st : St), st.box = 0 →
    (flowFold (List.replicate (k + 1) Op.emit) st).box = 1
      ∧ (flowFold (List.replicate (k + 1) Op.emit) st).used = st.used + 1
      ∧ (flowFold (List.replicate (k + 1) Op.emit) st).refused
          = st.refused + k := by
  intro k st h0
  have hcons : flowFold (List.replicate (k + 1) Op.emit) st
      = flowFold (List.replicate k Op.emit) (applyOp st Op.emit) := rfl
  have hbox : (applyOp st Op.emit).box = 1 := by simp [applyOp, h0]
  have hub : (applyOp st Op.emit).used = st.used + 1 := by simp [applyOp, h0]
  have hrb : (applyOp st Op.emit).refused = st.refused := by
    simp [applyOp, h0]
  have hfull := emit_full_box k (applyOp st Op.emit) hbox
  rw [hcons]
  refine ⟨hfull.1, ?_, ?_⟩
  · rw [hfull.2.1, hub]
  · rw [hfull.2.2, hrb]

/-- The #10/#17 cycle lemma (adjudicated): when a flow's word is
consume-then-emit, stage-1 consumption empties the delay box before the
same tick's emission refills it -- for any incoming depth 0 or 1, one
tick leaves depth one and adds no refusal. The word shape is an explicit
theorem hypothesis, per the cadence-audit discipline. -/
theorem cycle_warm_no_refusal : ∀ (i : Nat) (st : St), st.box ≤ 1 →
    opsOf i = [Op.consume, Op.emit] →
    (flowFold (opsOf i) st).box = 1 ∧ (flowFold (opsOf i) st).refused
      = st.refused := by
  intro i st hb hw
  rw [hw]
  by_cases h0 : st.box = 0
  · simp [flowFold, applyOp, h0]
  · have h1 : st.box = 1 := by omega
    simp [flowFold, applyOp, h1]

/-- Under multiplicity k + 1 on a cycle flow, the extra copies are
refused by the same tick's emit, not left hovering: the burst lands on
an empty box (one copy accepted), then the consume-emit word restores
depth one with refused grown by exactly k. -/
theorem cycle_burst_refuses_extras : ∀ (k : Nat) (st : St) (i : Nat),
    st.box = 0 → opsOf i = [Op.consume, Op.emit] →
    (flowFold (opsOf i) (flowFold (List.replicate (k + 1) Op.emit) st)).box
      = 1
      ∧ (flowFold (opsOf i) (flowFold (List.replicate (k + 1) Op.emit) st)).refused
          = st.refused + k := by
  intro k st i h0 hw
  have hburst := emit_empty_box k st h0
  have hb1 : (flowFold (List.replicate (k + 1) Op.emit) st).box ≤ 1 := by
    omega
  have h1 := cycle_warm_no_refusal _ _ hb1 hw
  rw [hw] at h1 ⊢
  refine ⟨h1.1, ?_⟩
  rw [h1.2, hburst.2.2]

theorem flow_attempts_raw (i x : Nat) :
    (tickFlow i x).refused + (tickFlow i x).used = emitCount (opsOf i) := by
  have h0 := fold_attempt (opsOf i) (mkSt x)
  simp only [mkSt_fields, Nat.zero_add, Nat.add_zero] at h0
  exact h0

theorem flow_take_raw (i x : Nat) :
    (tickFlow i x).consumed + (tickFlow i x).miss
      = consumeCount (opsOf i) := by
  have h0 := fold_take (opsOf i) (mkSt x)
  simp only [mkSt_fields, Nat.zero_add, Nat.add_zero] at h0
  exact h0

theorem flow_event (i x : Nat) :
    (tickFlow i x).used + x
      = (tickFlow i x).consumed + (tickFlow i x).sunk
          + (tickFlow i x).box := by
  have h0 := fold_event (opsOf i) (mkSt x)
  simp only [mkSt_fields, Nat.zero_add, Nat.add_zero] at h0
  exact h0

/-- INV-LIVENESS: every ledger flow emits exactly once per tick. -/
theorem emit_liveness : ∀ i : Nat, 1 ≤ i → i < 28 → emitCount (opsOf i) = 1 := by
  intro i h1 hi
  match i with
  | 0 => omega
  | 1 => rfl
  | 2 => rfl
  | 3 => rfl
  | 4 => rfl
  | 5 => rfl
  | 6 => rfl
  | 7 => rfl
  | 8 => rfl
  | 9 => rfl
  | 10 => rfl
  | 11 => rfl
  | 12 => rfl
  | 13 => rfl
  | 14 => rfl
  | 15 => rfl
  | 16 => rfl
  | 17 => rfl
  | 18 => rfl
  | 19 => rfl
  | 20 => rfl
  | 21 => rfl
  | 22 => rfl
  | 23 => rfl
  | 24 => rfl
  | 25 => rfl
  | 26 => rfl
  | 27 => rfl
  | j + 28 => omega

/-- Every flow either consumes or drains as a sink, exactly once. -/
theorem consume_sink_split : ∀ i : Nat, 1 ≤ i → i < 28 →
    consumeCount (opsOf i) + fsinkone i = 1 := by
  intro i h1 hi
  match i with
  | 0 => omega
  | 1 => rfl
  | 2 => rfl
  | 3 => rfl
  | 4 => rfl
  | 5 => rfl
  | 6 => rfl
  | 7 => rfl
  | 8 => rfl
  | 9 => rfl
  | 10 => rfl
  | 11 => rfl
  | 12 => rfl
  | 13 => rfl
  | 14 => rfl
  | 15 => rfl
  | 16 => rfl
  | 17 => rfl
  | 18 => rfl
  | 19 => rfl
  | 20 => rfl
  | 21 => rfl
  | 22 => rfl
  | 23 => rfl
  | 24 => rfl
  | 25 => rfl
  | 26 => rfl
  | 27 => rfl
  | j + 28 => omega

theorem step_used : ∀ i : Nat, 1 ≤ i → i < 28 →
    (tickFlow i (fbox i)).used = 1 := by
  intro i h1 hi
  have h0 := flow_attempts_raw i (fbox i)
  have he := emit_liveness i h1 hi
  have hr := step_refused i
  omega

theorem step_consumed : ∀ i : Nat,
    (tickFlow i (fbox i)).consumed = consumeCount (opsOf i) := by
  intro i
  have h0 := flow_take_raw i (fbox i)
  have hm := step_miss i
  omega

/-- Identity A at the master profile: attempted = accepted + refused,
and the canonical schedule refuses nothing (attempted = accepted = 1). -/
theorem attempts_at_master : ∀ i : Nat, 1 ≤ i → i < 28 →
    (tickFlow i (fbox i)).refused + (tickFlow i (fbox i)).used = 1 := by
  intro i h1 hi
  have h0 := flow_attempts_raw i (fbox i)
  rw [emit_liveness i h1 hi] at h0
  exact h0

/-- Identity B at the master profile: accepted = consumed + sunk +
depth, per flow per tick (delta-depth = box' - fbox i; delta-sunk =
fsinkone i since the sunk counter enters each tick at zero). -/
theorem balance_at_master : ∀ i : Nat, 1 ≤ i → i < 28 →
    (tickFlow i (fbox i)).used + fbox i
      = (tickFlow i (fbox i)).consumed + (tickFlow i (fbox i)).sunk
          + (tickFlow i (fbox i)).box := by
  intro i h1 hi
  exact flow_event i (fbox i)


/-! ## Typed geometry payloads

Payload schema (user-adjudicated, round 11 ruling A):

- the D2 (Multi-Layer Mat) write channels are pinned **per flow**: #18
  births one candidate record into the candidate index (kind `crystal`,
  so 18 -> crystal) and #24 ratchets one revalidated overlay into the
  overlay index (kind `overlay`, so 24 -> overlay). The split is
  `candidateWriteFids = [18]`, `overlayWriteFids = [24]`:
  disjoint, together exactly `d2WriteFids = [18, 24]`, and both absorbed
  (recorded) on the spine;
- the candidate kind is `crystal` (an unvetted emergent crystal living in
  the nursery) and the ratcheted kind is `overlay`; a candidate is not an
  overlay and vice versa, and `d2Allowed` is exactly their union. (The
  Python exact-type gate on `PAYLOAD_SCHEMA` is what rejects a body of
  the wrong kind; this mirror states the partition.)
- the candidate index is a separate store with its own lifecycle (below);
- D4 (Base Core) write [22] carries bias primitives only.
  The whitelist closes the channel by construction: a trajectory,
  state-delta, or context payload kind is not forbidden on D4 -- it is
  unrepresentable;
- the overlay index recycles one overlay per tick and evicts past
  capacity 4, so no resident epoch falls more than one tick
  behind the present (INV-NO-OSSIFY). -/

inductive PayloadKind where
  | traj | delta | ctx | overlay | crystal | bias
  deriving DecidableEq

def d4Allowed : List PayloadKind := [PayloadKind.bias]
def d2Allowed : List PayloadKind := [PayloadKind.overlay, PayloadKind.crystal]
def candidateAllowed : List PayloadKind := [PayloadKind.crystal]
def overlayAllowed : List PayloadKind := [PayloadKind.overlay]
def forbiddenOfGeometry : List PayloadKind :=
  [PayloadKind.traj, PayloadKind.delta, PayloadKind.ctx]

def d4WriteFids : List Nat := [22]
def d2WriteFids : List Nat := [18, 24]
def candidateWriteFids : List Nat := [18]
def overlayWriteFids : List Nat := [24]

/-- INV-EMPTINESS as a type-level fact: the forbidden kinds are excluded
from every geometry write channel. Adding `crystal` to the D2 channel
does not open it: the purity statement is about traj/delta/ctx only. -/
theorem geometry_write_channel_purity :
    ∀ k ∈ forbiddenOfGeometry, k ∉ d4Allowed ∧ k ∉ d2Allowed := by
  intro k hk
  cases k <;> simp_all [d4Allowed, d2Allowed, forbiddenOfGeometry]

/-- Both geometry write channels are absorbed (compiled to consume) on
the spine.  Round 11: #18 births the candidate (candidate index) and #24
ratchets the overlay (overlay index); each D2 write flow is one of the
two, so neither reading is optional. -/
theorem geometry_writes_absorbed :
    d4WriteFids = [22] ∧ d2WriteFids = [18, 24] ∧
      (opsOf 22).getLast? = some Op.consume ∧
      (opsOf 18).getLast? = some Op.consume ∧
      (opsOf 24).getLast? = some Op.consume :=
  ⟨rfl, rfl, by decide, by decide, by decide⟩

/-- Ruling A, per-flow write pin: the candidate-birth channel and the
overlay-ratchet channel are disjoint and together are exactly the D2
writes; both are absorbed on the spine. -/
theorem d2_write_split :
    candidateWriteFids ++ overlayWriteFids = d2WriteFids ∧
    (∀ f : Nat, f ∈ candidateWriteFids → f ∉ overlayWriteFids) ∧
    (opsOf 18).getLast? = some Op.consume ∧
    (opsOf 24).getLast? = some Op.consume := by
  refine ⟨rfl, by decide, by decide, by decide⟩

/-- The body type pin: the D2 candidate index is written by exactly one
flow and stored as exactly one kind -- #18 births the `crystal`
kind.  Nat-level companion to the Python exact-type gate on
`PAYLOAD_SCHEMA[18]`. -/
theorem candidate_recorded_from_birth :
    candidateWriteFids = [18] ∧
    (∀ f : Nat, f ∈ candidateWriteFids → f ∈ d2WriteFids) ∧
    candidateAllowed = [PayloadKind.crystal] ∧
    d2Allowed = overlayAllowed ++ candidateAllowed ∧
    (opsOf 18).getLast? = some Op.consume := by
  refine ⟨rfl, by decide, rfl, rfl, by decide⟩


/-! ## Candidate index (D2 nursery) lifecycle

Ruling A splits the D2 store: the overlay index keeps its policy
(`mat_*_policy`, unchanged and deliberately not restated here) and the
candidate index is a second store with its own lifecycle. The recurrence
is pure and core-only: `nurseryTick` births the tick's own id (append)
and drops the oldest record iff the index is over `NURSERY_CAPACITY`;
`promote` removes a candidate id, which is the #22 lineage consumption;
`nurseryContinue` replays the birth/eviction tick from an arbitrary
promoted state.

- `nurseryTick_length` / `nursery_bounded`: the index never holds more
  than `NURSERY_CAPACITY` candidates. The step lemma carries the incoming
  capacity as an explicit hypothesis, because a single tick cannot shrink
  an already-oversized index by more than one record;
- `nursery_birth_member`: the birth id of a tick is in the state right
  after its own birth -- eviction drops the oldest record, never the
  newborn (the unconditional form, no hypothesis needed);
- `nursery_fresh`: the id *born* at tick t is still resident at tick
  t + 1 (one tick of guaranteed residence for a newborn). This is not the
  claim that every resident survives one tick -- the oldest of four
  residents is evicted by the next birth. The hypothesis `1 ≤ t` is
  explicit: the run starts empty and its first birth id is 1, so at
  t = 0 the statement has no subject;
- `nursery_runs_distinct`: ids are pairwise distinct in every state, so a
  fresh birth never resurrects an evicted id;
- `nursery_promote_resident`: promoting an id that is not resident is the
  identity -- there is no state effect to hide behind a refusal;
- `nursery_promote_once` / `nursery_promote_twice`: an id promoted out at
  tick t is absent from every later state of the continued run, hence a
  second promotion of the same id is the identity (INV-PROMOTE-ONCE).
-/

/-- One nursery tick: FIFO birth (append the tick's own id), then drop
the oldest record iff the index exceeds `NURSERY_CAPACITY`. -/
def nurseryTick (l : List Nat) (t : Nat) : List Nat :=
  if (l ++ [t]).length > 4 then (l ++ [t]).drop 1 else l ++ [t]

/-- The nursery state after t ticks from empty. -/
def nurseryRun : Nat → List Nat
  | 0 => []
  | t + 1 => nurseryTick (nurseryRun t) (t + 1)

/-- #22 lineage consumption: drop a candidate id from the index. -/
def promote : List Nat → Nat → List Nat
  | [], _ => []
  | a :: rest, id => if a = id then promote rest id else a :: promote rest id

theorem nurseryTick_mem_append {l : List Nat} {t e : Nat}
    (he : e ∈ nurseryTick l t) : e ∈ l ++ [t] := by
  unfold nurseryTick at he
  by_cases hc : (l ++ [t]).length > 4
  · rw [if_pos hc] at he
    exact List.mem_of_mem_drop he
  · rw [if_neg hc] at he
    exact he

theorem nurseryTick_mem {l : List Nat} {t e : Nat}
    (he : e ∈ nurseryTick l t) : e ∈ l ∨ e = t := by
  have h1 : e ∈ l ++ [t] := nurseryTick_mem_append he
  rw [List.mem_append] at h1
  rcases h1 with h | h
  · exact Or.inl h
  · exact Or.inr (by simpa using h)

theorem nurseryTick_length (l : List Nat) (t : Nat)
    (h : l.length ≤ 4) :
    (nurseryTick l t).length ≤ 4 := by
  have hlen : (l ++ [t]).length = l.length + 1 := by simp
  unfold nurseryTick
  by_cases hc : (l ++ [t]).length > 4
  · rw [if_pos hc, List.length_drop, hlen]
    omega
  · rw [if_neg hc, hlen]
    omega

theorem nursery_bounded : ∀ t : Nat,
    (nurseryRun t).length ≤ 4 := by
  intro t
  induction t with
  | zero => simp [nurseryRun]
  | succ k ih => exact nurseryTick_length _ _ ih

theorem nurseryRun_le : ∀ (t e : Nat), e ∈ nurseryRun t → e ≤ t := by
  intro t
  induction t with
  | zero => intro e he; simp [nurseryRun] at he
  | succ k ih =>
      intro e he
      have h1 := nurseryTick_mem he
      rcases h1 with h | h
      · have := ih e h; omega
      · omega

theorem mem_drop_one_cons {a : Nat} {r : List Nat} {t : Nat} :
    t ∈ ((a :: r) ++ [t]).drop 1 := by
  show t ∈ (a :: (r ++ [t])).drop 1
  cases r with
  | nil => simp
  | cons b s => simp

theorem mem_drop_one_append (l : List Nat) (t : Nat) (h : l ≠ []) :
    t ∈ (l ++ [t]).drop 1 := by
  cases l with
  | nil => exact absurd rfl h
  | cons a r => exact mem_drop_one_cons

/-- The birth id of tick `t + 1` is in the state right after its own
birth: the unconditional form of freshness (no hypothesis needed). -/
theorem nursery_birth_member (t : Nat) : t + 1 ∈ nurseryRun (t + 1) := by
  show t + 1 ∈ nurseryTick (nurseryRun t) (t + 1)
  unfold nurseryTick
  by_cases hc : ((nurseryRun t) ++ [t + 1]).length > 4
  · rw [if_pos hc]
    exact mem_drop_one_append _ _ (by
      intro h0
      rw [h0] at hc
      simp at hc)
  · rw [if_neg hc]
    simp

/-- Appending then dropping the front keeps the tail, for a non-empty
incoming record list. -/
theorem drop_one_append (l : List Nat) (t : Nat) (h : l ≠ []) :
    (l ++ [t]).drop 1 = l.drop 1 ++ [t] := by
  cases l with
  | nil => exact absurd rfl h
  | cons a r => rfl

/-- The newest record is always the last one: one tick appends its own id
and eviction drops the oldest record. -/
theorem nurseryRun_getLast (t : Nat) :
    (nurseryRun (t + 1)).getLast? = some (t + 1) := by
  show (nurseryTick (nurseryRun t) (t + 1)).getLast? = some (t + 1)
  unfold nurseryTick
  by_cases hc : ((nurseryRun t) ++ [t + 1]).length > 4
  · rw [if_pos hc, drop_one_append _ _ (by
      intro h0
      rw [h0] at hc
      simp at hc)]
    simp
  · rw [if_neg hc]
    simp

/-- Freshness, one tick of residence: an id resident at tick `t` is still
resident at tick `t + 1` -- eviction drops the oldest record, never the
newest, so a birth survives at least one further tick. The hypothesis
`1 ≤ t` is explicit because the run starts empty and its first birth id is
1: there is no id 0, so at t = 0 the statement has no subject. -/
theorem nursery_fresh (t : Nat) (h : 1 ≤ t) : t ∈ nurseryRun (t + 1) := by
  have hbirth : t ∈ nurseryRun t := by
    have h0 := nursery_birth_member (t - 1)
    rwa [Nat.sub_add_cancel h] at h0
  have hlast : (nurseryRun t).getLast? = some t := by
    have h0 := nurseryRun_getLast (t - 1)
    rwa [Nat.sub_add_cancel h] at h0
  show t ∈ nurseryTick (nurseryRun t) (t + 1)
  unfold nurseryTick
  by_cases hc : ((nurseryRun t) ++ [t + 1]).length > 4
  · rw [if_pos hc]
    have hlen : 2 ≤ (nurseryRun t).length := by
      have h1 : ((nurseryRun t) ++ [t + 1]).length
          = (nurseryRun t).length + 1 := by simp
      omega
    obtain ⟨ys, hys⟩ := List.getLast?_eq_some_iff.mp hlast
    have hysne : ys ≠ [] := by
      intro h0
      rw [h0] at hys
      rw [hys] at hlen
      simp at hlen
    rw [hys, drop_one_append (ys ++ [t]) (t + 1) (by simp),
      drop_one_append ys t hysne]
    simp
  · rw [if_neg hc]
    exact List.mem_append.mpr (Or.inl hbirth)

theorem nodup_snoc (l : List Nat) (t : Nat) :
    l.Nodup → t ∉ l → (l ++ [t]).Nodup := by
  induction l with
  | nil => intro _ _; simp
  | cons a r ih =>
      intro hnod ht
      show (a :: (r ++ [t])).Nodup
      rw [List.nodup_cons] at hnod ⊢
      refine ⟨?_, ih hnod.2 (fun hm => ht (List.mem_cons_of_mem a hm))⟩
      intro hm
      rw [List.mem_append] at hm
      rcases hm with h1 | h1
      · exact hnod.1 h1
      · have hat : a = t := by simpa using h1
        exact ht (by rw [← hat]; exact List.mem_cons_self)

theorem nursery_runs_distinct : ∀ t : Nat, (nurseryRun t).Nodup := by
  intro t
  induction t with
  | zero => simp [nurseryRun]
  | succ k ih =>
      have hd : k + 1 ∉ nurseryRun k := by
        intro hm
        have := nurseryRun_le k (k + 1) hm
        omega
      have hnod : ((nurseryRun k) ++ [k + 1]).Nodup := nodup_snoc _ _ ih hd
      show (nurseryTick (nurseryRun k) (k + 1)).Nodup
      unfold nurseryTick
      by_cases hc : ((nurseryRun k) ++ [k + 1]).length > 4
      · rw [if_pos hc]
        exact List.Nodup.sublist (List.drop_sublist 1 _) hnod
      · rw [if_neg hc]
        exact hnod

theorem nursery_promote_resident : ∀ (l : List Nat) (id : Nat),
    id ∉ l → promote l id = l := by
  intro l
  induction l with
  | nil => intro id _; rfl
  | cons a r ih =>
      intro id hid
      have ha : ¬ (a = id) := by
        intro hEq
        exact hid (by rw [← hEq]; exact List.mem_cons_self)
      have hr : id ∉ r := fun hm => hid (List.mem_cons_of_mem a hm)
      show (if a = id then promote r id else a :: promote r id) = a :: r
      rw [if_neg ha, ih id hr]

theorem promote_not_mem : ∀ (l : List Nat) (id : Nat), id ∉ promote l id := by
  intro l
  induction l with
  | nil => intro id; simp [promote]
  | cons a r ih =>
      intro id
      show id ∉ (if a = id then promote r id else a :: promote r id)
      by_cases ha : a = id
      · rw [if_pos ha]
        exact ih id
      · rw [if_neg ha]
        intro hm
        rcases List.mem_cons.mp hm with h1 | h1
        · exact ha h1.symm
        · exact ih id h1

/-- Replay the nursery from an arbitrary state, with the next birth at
tick `next` (the organ's state right after a promotion at tick next-1). -/
def nurseryContinue (l : List Nat) (next : Nat) : Nat → List Nat
  | 0 => l
  | k + 1 => nurseryTick (nurseryContinue l next k) (next + k)

/-- An id below the next birth tick and absent from the current state is
never reborn: births are fresh and eviction only drops. -/
theorem nurseryContinue_far {l : List Nat} {next id : Nat}
    (hlt : id < next) (hnot : id ∉ l) :
    ∀ u : Nat, id ∉ nurseryContinue l next u := by
  intro u
  induction u with
  | zero => simpa [nurseryContinue] using hnot
  | succ k ih =>
      intro hm
      rcases nurseryTick_mem hm with h1 | h1
      · exact ih h1
      · omega

theorem nursery_promote_once : ∀ (t id : Nat), id ∈ nurseryRun t →
    ∀ u : Nat, id ∉ nurseryContinue (promote (nurseryRun t) id) (t + 1) u := by
  intro t id hmem u
  have hle : id ≤ t := nurseryRun_le t id hmem
  exact nurseryContinue_far (by omega) (promote_not_mem (nurseryRun t) id) u

/-- INV-PROMOTE-ONCE: promoting an id out of a distinct-id state and
replaying the run, a second promotion of the same id is the identity. -/
theorem nursery_promote_twice : ∀ (t id : Nat), id ∈ nurseryRun t →
    ∀ u : Nat,
      promote (nurseryContinue (promote (nurseryRun t) id) (t + 1) u) id
        = nurseryContinue (promote (nurseryRun t) id) (t + 1) u := by
  intro t id hmem u
  exact nursery_promote_resident _ _ (nursery_promote_once t id hmem u)


/-- One mat tick: birth appended, head recycled at the current epoch,
then an eviction iff the board exceeds capacity 4. -/
def revTop (l : List Nat) (t : Nat) : List Nat :=
  match l with
  | [] => [t]
  | _ :: rest => rest ++ [t]

def matTick (l : List Nat) (t : Nat) : List Nat :=
  let rev := revTop (l ++ [t]) t
  if rev.length > 4 then rev.drop 1 else rev

def matRun : Nat → List Nat
  | 0 => [0]
  | t + 1 => matTick (matRun t) (t + 1)

theorem rep2 (v : Nat) : List.replicate 2 v = v :: v :: [] := rfl
theorem mat_close_1 : matRun 1 = [1, 1] := rfl
theorem mat_close_2 : matRun 2 = [1, 2, 2] := rfl

/-- The operational run coincides with the two-band closed shape:
from tick 3 the resident epochs are exactly {t-1, t-1, t, t}. -/
theorem matTick_length : ∀ (s : List Nat) (t : Nat), s.length ≤ 4 →
    (matTick s t).length ≤ 4 := by
  intro s t h
  cases s with
  | nil => simp [matTick, revTop]
  | cons a r =>
      have hrev : revTop ((a :: r) ++ [t]) t = (r ++ [t]) ++ [t] := rfl
      simp only [matTick, hrev]
      have hlen : ((r ++ [t]) ++ [t]).length = r.length + 2 := by simp
      rw [hlen]
      have hcons : (a :: r).length = r.length + 1 := rfl
      by_cases hr : r.length + 2 > 4
      · rw [if_pos hr, List.length_drop, hlen]
        omega
      · rw [if_neg hr, hlen]
        omega

/-- Policy-relative form: the schedule is an explicit hypothesis, not a
silent assumption. These theorems quantify over EVERY resident-epoch
stream that obeys the mat update law (seed [0], one matTick per tick) —
they say nothing about arrival streams outside that law. -/
theorem mat_operational_policy : ∀ (run : Nat → List Nat),
    run 0 = [0] → (∀ k, run (k + 1) = matTick (run k) (k + 1)) →
    ∀ t, run (t + 3)
      = List.replicate 2 (t + 2) ++ List.replicate 2 (t + 3) := by
  intro run h0 hU t
  induction t with
  | zero =>
      rw [hU 2, hU 1, hU 0, h0]
      rfl
  | succ k ih =>
      have hlhs : run (k + 4) = matTick (run (k + 3)) (k + 4) := hU (k + 3)
      rw [hlhs, ih, rep2]
      simp [matTick, revTop]

/-- INV-NO-OSSIFY, policy-relative: no resident epoch falls more than
one tick behind — for every stream obeying the update law. -/
theorem mat_fresh_policy : ∀ (run : Nat → List Nat),
    run 0 = [0] → (∀ k, run (k + 1) = matTick (run k) (k + 1)) →
    ∀ t, 1 ≤ t → ∀ e ∈ run t, e = t ∨ e + 1 = t := by
  intro run h0 hU t
  match t with
  | 0 => intro h; omega
  | 1 =>
      intro _ e he
      have h1 : run 1 = [1, 1] := by rw [hU 0, h0]; rfl
      rw [h1] at he
      simp at he
      omega
  | 2 =>
      intro _ e he
      have h2 : run 2 = [1, 2, 2] := by rw [hU 1, hU 0, h0]; rfl
      rw [h2] at he
      simp at he
      omega
  | t + 3 =>
      intro _ e he
      rw [mat_operational_policy run h0 hU t, rep2] at he
      simp at he
      omega

/-- Capacity bound, policy-relative: for every stream obeying the
update law, the mat never exceeds its capacity. -/
theorem mat_bounded_policy : ∀ (run : Nat → List Nat),
    run 0 = [0] → (∀ k, run (k + 1) = matTick (run k) (k + 1)) →
    ∀ t, (run t).length ≤ 4 := by
  intro run h0 hU t
  induction t with
  | zero => rw [h0]; decide
  | succ k ih =>
      rw [hU k]
      exact matTick_length (run k) (k + 1) ih

/-- The dry-run minter satisfies the law, so the policy theorems
specialize to it. -/
theorem mat_operational : ∀ t : Nat, matRun (t + 3)
    = List.replicate 2 (t + 2) ++ List.replicate 2 (t + 3) :=
  mat_operational_policy matRun rfl (fun _ => rfl)

/-- INV-NO-OSSIFY for the dry-run minter. -/
theorem mat_fresh : ∀ t : Nat, 1 ≤ t →
    ∀ e ∈ matRun t, e = t ∨ e + 1 = t :=
  mat_fresh_policy matRun rfl (fun _ => rfl)

/-- Capacity bound for the dry-run minter. -/
theorem mat_bounded : ∀ t : Nat, (matRun t).length ≤ 4 :=
  mat_bounded_policy matRun rfl (fun _ => rfl)

